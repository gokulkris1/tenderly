# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/server/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!server/.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/dist-netlify/
/server/dist/
/.npm-cache/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# e2e output
/playwright-report/
/test-results/

# credentials never enter the repo — they live in ~/.tenderly/secrets.env
