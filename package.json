{
  "name": "tenderly-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.netlify.config.ts",
    "build": "vite build --config vite.netlify.config.ts",
    "build:netlify": "npm run build",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.mjs",
    "check:conflicts": "node scripts/check-conflict-markers.mjs",
    "backup:verify": "node scripts/backup/rehearse-restore.mjs",
    "seed:staging": "node scripts/seed-staging.mjs",
    "import:ogp": "node scripts/import-ogp.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tenderly/shared": "file:./packages/shared",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "8.0.13"
  },
  "type": "module",
  "displayName": "Tenderly"
}
